<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    The permissions the capture loop cannot work without.

    ACCESS_BACKGROUND_LOCATION is deliberately *not* here. A foreground
    service with the `location` type may use the foreground permission while
    it runs, and asking for the background one triggers Play Store review of a
    permission this design does not need. See ADR-0002.
  -->
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!--
    RECEIVE_BOOT_COMPLETED, because a three-day trip outlives a reboot and a
    phone that restarts in a lorry park must come back recording rather than
    waiting for somebody to notice.
  -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <application>
    <service
      android:name=".TrackingService"
      android:enabled="true"
      android:exported="false"
      android:foregroundServiceType="location" />

    <!--
      How one app hands another a file (ADR-0024). The authority carries the
      application id so the library serves whichever package links it.
    -->
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.backhaul.documents"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/backhaul_documents_paths" />
    </provider>

    <receiver
      android:name=".BootReceiver"
      android:enabled="true"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
